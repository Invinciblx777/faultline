# FAULTLINE configuration. Copy to .env (or run `pnpm setup:env`) and fill in secrets.
# Never commit .env. Never put AI provider or Devin keys in NEXT_PUBLIC_* variables.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_USER=faultline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faultline
POSTGRES_PORT=5432
MINIO_ROOT_USER=faultline
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Database ---
DATABASE_URL=postgres://faultline:change-me@127.0.0.1:5432/faultline
# Used only by automated tests. Must point at a separate database.
DATABASE_URL_TEST=postgres://faultline:change-me@127.0.0.1:5432/faultline_test

# --- Artifact storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=faultline-artifacts
S3_ACCESS_KEY_ID=faultline
S3_SECRET_ACCESS_KEY=change-me-too
S3_FORCE_PATH_STYLE=true

# --- Scan authorization ---
# local:  operator-only mode. Allowlisted private/loopback targets (e.g. http://localhost:4600) may be scanned.
# public: non-public addresses are always refused. Requires worker network isolation (see docs/deployment.md).
FAULTLINE_DEPLOYMENT_MODE=local
# Comma-separated origins the operator controls or is explicitly authorized to test.
# The reference target serves its shop on :4600 and a simulated third-party partner on :4601.
# Exact origins (https://example.com) or subdomain wildcards (https://*.example.com).
FAULTLINE_SCAN_ALLOWLIST=http://localhost:4600,http://localhost:4601
# public: subresources may load from any public host on ports 80/443.
# allowlist: every browser connection must target an allowlisted origin.
FAULTLINE_SUBRESOURCE_POLICY=public

# --- Web application ---
FAULTLINE_SESSION_TTL_HOURS=12
# auto = Secure cookies when NODE_ENV=production. Use false only for plain-http local production builds.
FAULTLINE_COOKIE_SECURE=auto

# --- Worker ---
FAULTLINE_WORKER_CONCURRENCY=1
FAULTLINE_NAVIGATION_TIMEOUT_MS=30000
FAULTLINE_SETTLE_TIMEOUT_MS=5000
FAULTLINE_SCENARIO_TIMEOUT_MS=120000
FAULTLINE_MAX_REDIRECTS=10
FAULTLINE_MAX_REQUESTS=1500
FAULTLINE_MAX_TRANSFER_BYTES=104857600
FAULTLINE_MAX_SCREENSHOT_HEIGHT=6000
FAULTLINE_CHROMIUM_SANDBOX=true
# Wall-clock budget for one Blast Radius analysis (must stay under the 60-minute job expiry).
FAULTLINE_ANALYSIS_TIMEOUT_MS=1800000
# Run generated regression tests with Playwright Test against the target after each analysis.
FAULTLINE_REGRESSION_VALIDATION=true
# Blast Radius analyses allowed to be queued or running at once (web app setting).
FAULTLINE_MAX_ACTIVE_ANALYSES=2
# Must be true to start the worker in public mode. Confirms OS/network-level egress isolation is in place.
FAULTLINE_NETWORK_ISOLATION_ACK=false

# --- Phase 3: Devin repair and independent verification (all optional) ---
# Devin API v3 service-user key (starts with cog_) and organization id (starts with org-).
# Server-side only. Leave empty to keep repair approval disabled. Never commit real values.
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_API_BASE_URL=https://api.devin.ai
# Optional cap on ACUs per session (0 = Devin's default).
DEVIN_MAX_ACU_LIMIT=0
# How often the worker polls an active Devin session and its pull request.
FAULTLINE_DEVIN_POLL_INTERVAL_MS=20000
# Upload the finding's two screenshots to Devin as attachments after approval.
FAULTLINE_DEVIN_ATTACH_SCREENSHOTS=true
# Read-only GitHub token (fine-grained: Contents read, Pull requests read) for the linked repositories.
GITHUB_TOKEN=
# Repositories that may be linked for repair, comma-separated owner/name. Empty = repair disabled.
FAULTLINE_REPAIR_REPOSITORIES=
# Operator usernames allowed to approve Devin sessions, comma-separated.
FAULTLINE_REPAIR_APPROVERS=
# Isolated verification of candidate commits.
FAULTLINE_CONTAINER_RUNTIME=podman
# Pinned by digest; the image that runs `node <entry>` for each commit.
# FAULTLINE_VERIFY_IMAGE=docker.io/library/node@sha256:025b8e975a61d94e33abeafaad1255ef44e4898cf1a1b6446860009c72e6d284
# Internal (no egress) container network, created on first use.
FAULTLINE_VERIFY_NETWORK=faultline-verify
# Candidates listen on 127.0.0.1:<base> (and <base>+1… for extra ports). Add those origins to FAULTLINE_SCAN_ALLOWLIST,
# e.g. http://localhost:4700,http://localhost:4701.
FAULTLINE_VERIFY_BASE_PORT=4700

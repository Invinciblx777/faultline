{
  "name": "@faultline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "node scripts/lint-tokens.mjs && eslint src e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "tokens:generate": "node scripts/gen-tokens.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "a11y": "node tests/visual/lighthouse-a11y.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@faultline/db": "workspace:*",
    "@faultline/shared": "workspace:*",
    "@fontsource-variable/manrope": "5.3.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "pg-boss": "12.38.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "13.5.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
